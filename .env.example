# Discord Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=replace_with_your_bot_token

# Optional: limit this bot to one server. Leave blank to allow every server it joined.
DISCORD_GUILD_ID=

# Optional: send moderation reports to a private moderator channel. Blank = report in the message channel.
MODERATION_CHANNEL_ID=

# Local paths; relative paths are resolved from the project folder.
MODEL_PATH=models/toxicity_model.joblib
DATA_PATH=data/moderation.sqlite3
TRAINING_DATA_PATH=data/training.csv
MODEL_OUTPUT_PATH=models/toxicity_model.joblib

# Scores range from 1 (benign) to 10 (severe).
WARNING_THRESHOLD=6
SEVERE_THRESHOLD=10
WARNINGS_BEFORE_TIMEOUT=3
WARNING_TIMEOUT_MINUTES=60
SEVERE_TIMEOUT_MINUTES=180
LOG_LEVEL=INFO
